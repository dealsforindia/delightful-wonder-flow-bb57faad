{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build:vercel",
  "outputDirectory": ".vercel/output",
  "crons": [
    {
      "path": "/api/public/cron/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
