# Copy this file to .env on your local machine or Azure VM and fill in your real values.
# For Vercel, add these in the Vercel dashboard under Project Settings → Environment Variables.

# Required for AI features (roadmap, chat, concierge).
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: route through an OpenAI-compatible provider instead of Google.
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Node environment. Usually set by the deployment platform.
NODE_ENV=production

# Internal port (Azure/PM2 only; Vercel ignores this).
PORT=3000

# Nitro preset. Vercel sets this automatically via package.json script.
# Override here only for Azure VM: NITRO_PRESET=node

