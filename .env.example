# Copy this file to .env on your Azure VM and fill in your real values.

# Required for AI features (roadmap, chat, concierge).
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: route through OpenAI-compatible provider instead of Google.
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Node environment (already set in ecosystem.config.cjs; no need to change).
NODE_ENV=production

# Port the app listens on internally. Nginx proxies this.
PORT=3000

# Leave this empty on Azure VM unless you want to deploy to Cloudflare.
# NITRO_PRESET=node
